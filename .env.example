# Server execution mode. Production deployments must use live.
APP_MODE="live"

# Supabase project configuration. The publishable key is safe for browser use; never expose a service-role key.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_WORKSPACE_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_WORKSPACE_ID=""

# Enable only after the Google provider is configured in Supabase Auth.
VITE_GOOGLE_AUTH_ENABLED="false"

# Optional public conversion destinations. Leave blank to hide the links.
PUBLIC_WHATSAPP_URL=""
PUBLIC_BOOKING_URL=""
PUBLIC_PRIVACY_URL=""
PUBLIC_TERMS_URL=""
PUBLIC_SUPPORT_NAME=""
PUBLIC_SUPPORT_TITLE=""
PUBLIC_SUPPORT_EMAIL=""
OPERATIONS_ALERT_EMAIL=""
