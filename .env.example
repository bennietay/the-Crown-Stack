# Server execution mode. Production deployments must use live.
APP_MODE="live"

# Required in production. JSON service-account object used only by Firebase Admin.
FIREBASE_SERVICE_ACCOUNT_KEY=""
# Leave blank to use Firestore's free-tier-friendly default database.
FIREBASE_DATABASE_ID=""
# Exact email allowed to provision the first workspace administrator on first sign-in.
BOOTSTRAP_ADMIN_EMAIL=""

# Firebase web-app values are public identifiers, not service secrets.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Leave blank to use the default Firestore database.
VITE_FIREBASE_DATABASE_ID=""

# Optional public conversion destinations. Leave blank to hide the links.
PUBLIC_WHATSAPP_URL=""
PUBLIC_BOOKING_URL=""
PUBLIC_PRIVACY_URL=""
PUBLIC_TERMS_URL=""
PUBLIC_SUPPORT_NAME=""
PUBLIC_SUPPORT_TITLE=""
PUBLIC_SUPPORT_EMAIL=""
OPERATIONS_ALERT_EMAIL=""
