# Required on the server for AI outreach drafting.
OPENAI_API_KEY=""

# Optional. Override if OpenAI changes your preferred ChatGPT model.
OPENAI_MODEL="gpt-5.5"

# Server runtime.
PORT="3000"
HOST="0.0.0.0"
APP_URL="http://localhost:3000"

# Supabase client config. The anon key is public, but keep it
# environment-specific so preview and production data stay separate.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
