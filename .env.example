# Server execution mode. Production deployments must use live.
APP_MODE="live"
PUBLIC_APP_URL="https://website.bennietay.com"
ADMIN_APP_URL="https://website.bennietay.com/admin"
CRON_SECRET="replace-with-a-long-random-secret"
WAAS_CRON_RUN_TIMEOUT_MS="240000"
# Secret used only by the standalone WAAS storefront to create idempotent orders.
WAAS_INGEST_API_KEY=""
# Master used to derive a different HMAC key for every managed website. The
# derived per-site value is installed in the connector's generated site config.
WAAS_CONNECTOR_INGEST_SECRET=""
WAAS_PORTAL_SECRET=""
WAAS_ASSET_BUCKET="waas-assets"

# Required for production WAAS deployment. Mock mode is available only outside production.
HOSTINGER_API_TOKEN=""
HOSTINGER_API_BASE_URL="https://developers.hostinger.com/api"
HOSTINGER_ORDER_ID=""
HOSTINGER_DATACENTER_CODE=""
HOSTINGER_USERNAME=""
HOSTINGER_WP_ADMIN_EMAIL=""
HOSTINGER_WP_SITE_TITLE=""
HOSTINGER_THEME_PATH=""
HOSTINGER_PLUGIN_PATH=""
HOSTINGER_TIMEOUT_MS="10000"
HOSTINGER_POLL_ATTEMPTS="12"
HOSTINGER_POLL_INTERVAL_MS="5000"

# Supabase project configuration. The publishable key is safe for browser use; never expose a service-role key.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_WORKSPACE_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_WORKSPACE_ID=""

# Enable only after the Google provider is configured in Supabase Auth.
VITE_GOOGLE_AUTH_ENABLED="false"

# Optional public conversion destinations. Leave blank to hide the links.
PUBLIC_WHATSAPP_URL=""
PUBLIC_BOOKING_URL=""
PUBLIC_PRIVACY_URL=""
PUBLIC_TERMS_URL=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
PUBLIC_SUPPORT_NAME=""
PUBLIC_SUPPORT_TITLE=""
PUBLIC_SUPPORT_EMAIL=""
OPERATIONS_ALERT_EMAIL=""

# Server-to-server Affiliate Operations ingestion. Generate a long random value
# and send it only as X-Affiliate-API-Key from the separate public affiliate backend.
AFFILIATE_INGEST_API_KEY=""

# Encrypt OAuth/provider credentials before they are persisted. Minimum 32 characters.
CREDENTIAL_ENCRYPTION_KEY=""

# Etsy Open API v3. Register this exact HTTPS callback in Etsy Your Apps.
ETSY_API_KEY=""
ETSY_SHARED_SECRET=""
ETSY_REDIRECT_URI="https://website.bennietay.com/api/integrations/etsy/callback"

# Optional Printify integration.
PRINTIFY_API_TOKEN=""

# Optional: enhances the evidence-only Daily CEO Brief. The deterministic brief works without it.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
