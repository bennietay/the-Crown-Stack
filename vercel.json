{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{dist,wordpress-themes,wordpress-plugin}/**"
    }
  },
  "crons": [
    { "path": "/api/cron/outreach", "schedule": "0 1 * * *" },
    { "path": "/api/cron/waas-deployments", "schedule": "0 2 * * *" }
  ],
  "rewrites": [
    { "source": "/healthz", "destination": "/api/index" },
    { "source": "/readyz", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
